# Managed by Ansible (addon_kata).
# The release's Rust shim. It uses the release's default config, QEMU with its own
# guest kernel and image (/opt/kata/share/defaults/kata-containers/runtime-rs/).
# No pod_annotations, so pods can't change hypervisor settings.
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.kata]
  runtime_type = "io.containerd.kata.v2"
  runtime_path = "{{ addon_kata_dir }}/runtime-rs/bin/containerd-shim-kata-v2"
  privileged_without_host_devices = true
